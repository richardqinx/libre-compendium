\NeedsTeXFormat{LaTeX2e}[2022-11-01]
\ProvidesPackage{lc-style-boxed}[2026/11/13 v0.1.0 带框视觉风格]
\RequirePackage{tcolorbox}
\tcbuselibrary{most}
\tcbset{lc/.style={enhanced,breakable,sharp corners,boxrule=0.6pt,leftrule=2.4pt,left=1.1mm,right=1.1mm,top=0.9mm,bottom=0.9mm,before skip=0.65em,after skip=0.65em,fonttitle=\bfseries,coltitle=lc-ink}}
\ExplSyntaxOn
\cs_set_protected:Npn\__lc_box_begin:nn#1#2{
 \str_case:enF{#1}{
 {lc-exam}{\begin{tcolorbox}[lc,colback=lc-exam!7,colframe=lc-exam,colbacktitle=lc-exam!14,title={#2}]}
 {lc-note}{\begin{tcolorbox}[lc,colback=lc-note!6,colframe=lc-note,colbacktitle=lc-note!14,title={#2}]}}
 {\begin{tcolorbox}[lc,colback=#1!5,colframe=#1,colbacktitle=#1!12,title={#2}]}}
\cs_set_protected:Npn\__lc_box_end:{\end{tcolorbox}}
\cs_set_protected:Npn\__lc_response:nn#1#2{\begin{tcolorbox}[lc,colback=lc-subtle,colframe=lc-ink!55,colbacktitle=lc-ink!8,title={\use:c{lc@name@#1}}]#2\end{tcolorbox}}
\ExplSyntaxOff
