\NeedsTeXFormat{LaTeX2e}[2022-11-01]
\ProvidesPackage{lc-page}[2026/11/13 v0.1.0 页面与页眉页脚]
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{booktabs}
\RequirePackage{array}
\setlist{itemsep=0.15em,topsep=0.3em}
\ExplSyntaxOn
\str_if_eq:eeTF{\lc@kind}{article}
 {\geometry{a4paper,left=2.6cm,right=2.6cm,top=2.5cm,bottom=2.5cm,headheight=15pt}}
 {\geometry{a4paper,left=2cm,right=2cm,top=2cm,bottom=2.2cm,headheight=15pt}}
\pagestyle{fancy}\fancyhf{}
\fancyhead[L]{\__lc_short_title:}
\str_case:en{\lc@kind}{
 {lecture}{\fancyhead[R]{\leftmark}}
 {problemset}{\fancyhead[R]{\g__lc_course_tl}}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}
\ExplSyntaxOff
