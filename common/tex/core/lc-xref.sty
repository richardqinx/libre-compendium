\RequirePackage{hyperref}
\RequirePackage[nameinlink]{cleveref}
\hypersetup{bookmarksnumbered=true}
\ExplSyntaxOn
\str_if_eq:eeTF{\lc@color}{gray}{\hypersetup{hidelinks}}{\hypersetup{colorlinks=true,linkcolor=lc-link,citecolor=lc-cite,urlcolor=lc-link}}
\AtBeginDocument{
 \cs_if_exist:NT\g__lc_abstract_keywords_tl{
  \tl_if_empty:NF\g__lc_abstract_keywords_tl{\tl_gset_eq:NN\g__lc_keywords_tl\g__lc_abstract_keywords_tl}}
 \hypersetup{pdftitle={\g__lc_title_tl},pdfauthor={\__lc_author:},pdfsubject={\g__lc_course_tl},pdfkeywords={\g__lc_keywords_tl}}}
\clist_map_inline:nn{definition,theorem,lemma,proposition,corollary,example,exercise,algorithm}{\crefname{#1}{\use:c{lc@name@#1}}{\use:c{lc@name@#1}}\Crefname{#1}{\use:c{lc@name@#1}}{\use:c{lc@name@#1}}}
\clist_map_inline:nn{equation,figure,table}{\crefname{#1}{\use:c{lc@name@#1}}{\use:c{lc@name@#1}}\Crefname{#1}{\use:c{lc@name@#1}}{\use:c{lc@name@#1}}}
\crefname{lstlisting}{\lc@name@listing}{\lc@name@listing}\Crefname{lstlisting}{\lc@name@listing}{\lc@name@listing}
\crefformat{equation}{#2\lc@name@equation\c_space_tl (#1)#3}\Crefformat{equation}{#2\lc@name@equation\c_space_tl (#1)#3}
\crefformat{chapter}{#2第#1章#3}\Crefformat{chapter}{#2第#1章#3}
\crefformat{section}{#2第~#1~节#3}\Crefformat{section}{#2第~#1~节#3}
\cs_if_exist:NTF\chapter{\counterwithin{equation}{chapter}\counterwithin{figure}{chapter}\counterwithin{table}{chapter}}{\counterwithin{equation}{section}\counterwithin{figure}{section}\counterwithin{table}{section}}
\ExplSyntaxOff
