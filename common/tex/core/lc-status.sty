\ExplSyntaxOn
\str_if_eq:eeTF{\lc@status}{draft}{
 \RequirePackage{showkeys}
 \AddToHook{shipout/background}{\put(\dimexpr0.5\paperwidth\relax,-\dimexpr0.5\paperheight\relax){\makebox(0,0){\rotatebox{45}{\textcolor{black!8}{\fontsize{80pt}{80pt}\selectfont\lc@name@draft}}}}}
 \NewDocumentCommand{\lctodo}{m}{\marginpar{\textcolor{\str_if_eq:eeTF{\lc@color}{gray}{black}{lc-pitfall}}{TODO：#1}}}
 \bool_if:NT\g__lc_font_fallback_bool{\fancyfoot[R]{\tiny\lc@name@fallback}}
}{\NewDocumentCommand{\lctodo}{m}{\PackageError{lc-status}{release~模式下存在~\string\lctodo：#1}{}}}
\ExplSyntaxOff
