% TeX4ht adapter for xeCJK hooks.
% TeX4ht prevents xeCJK from loading, but lc-fonts still names the CJK
% family-selection commands.  Keep those calls harmless in HTML; leave the
% regular fontspec commands to fontspec itself.
\providecommand\setCJKmainfont[2][]{ }
\providecommand\setCJKsansfont[2][]{ }
\providecommand\setCJKmonofont[2][]{ }
\providecommand\setCJKfamilyfont[3][]{ }
\ExplSyntaxOn
\cs_gset_eq:NN\string_Size\relax
\cs_gset_eq:NN\string_Size:\relax
\seq_if_exist:NF\fontspec_ht_scripts{\seq_new:N\fontspec_ht_scripts}
\ExplSyntaxOff
