% TeX4ht adapter for lc-xref: bypass cleveref's @cref section-label bug in
% TeX4ht while preserving Chinese cross-reference names and hyperlinks.
\ExplSyntaxOn
\cs_new_protected:Npn \__lc_html_cref_one:n #1
  {
    \regex_match:nnTF { \A def: } {#1} { \lc@name@definition\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A thm: } {#1} { \lc@name@theorem\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A lem: } {#1} { \lc@name@lemma\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A prop: } {#1} { \lc@name@proposition\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A cor: } {#1} { \lc@name@corollary\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A (?:eg|exm): } {#1} { \lc@name@example\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A ex: } {#1} { \lc@name@exercise\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A eq: } {#1} { \lc@name@equation\c_space_tl (\ref{#1}) }
    { \regex_match:nnTF { \A fig: } {#1} { \lc@name@figure\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A tab: } {#1} { \lc@name@table\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A lst: } {#1} { \lc@name@listing\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A alg: } {#1} { \lc@name@algorithm\c_space_tl \ref{#1} }
    { \regex_match:nnTF { \A (?:ch|chap): } {#1} { 第~\ref{#1}~章 }
    { \regex_match:nnTF { \A sec: } {#1} { 第~\ref{#1}~节 }
      { \ref{#1} } } } } } } } } } } } } } }
  }
\NewDocumentCommand{\__lc_html_cref}{m}
  {
    \bool_set_true:N \l_tmpa_bool
    \clist_map_inline:nn {#1}
      {
        \bool_if:NTF \l_tmpa_bool { \bool_set_false:N \l_tmpa_bool } { 、 }
        \__lc_html_cref_one:n {##1}
      }
  }
\AtBeginDocument{
  \RenewDocumentCommand{\cref}{s m}{\__lc_html_cref{#2}}
  \RenewDocumentCommand{\Cref}{s m}{\__lc_html_cref{#2}}
}
\ExplSyntaxOff
