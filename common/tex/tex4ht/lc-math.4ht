% TeX4ht adapter for lc-math.
% Keep the public mathematical command names available to the converter.
\providecommand{\mathbb}[1]{\mathrm{#1}}
\providecommand{\varnothing}{\emptyset}
\providecommand{\R}{\mathbb{R}}
\providecommand{\N}{\mathbb{N}}
\providecommand{\Z}{\mathbb{Z}}
\providecommand{\Q}{\mathbb{Q}}
\providecommand{\C}{\mathbb{C}}
\providecommand{\F}{\mathbb{F}}
\providecommand{\dd}{\mathop{}\!\mathrm{d}}
\providecommand{\e}{\mathrm{e}}
\providecommand{\ii}{\mathrm{i}}
\providecommand{\bm}[1]{\mathbf{#1}}
\providecommand{\set}[1]{\left\{#1\right\}}
\providecommand{\abs}[1]{\left\lvert#1\right\rvert}
\providecommand{\norm}[1]{\left\lVert#1\right\rVert}
\providecommand{\subsetneq}{\subset}
\providecommand{\nmid}{\not\mid}
\providecommand{\vDash}{\models}
\providecommand{\trianglelefteq}{\triangleleft}
\providecommand{\nleq}{\not\leq}
