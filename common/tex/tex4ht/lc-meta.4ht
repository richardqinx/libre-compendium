% TeX4ht adapter for lc-meta.
% TeX4ht's standard book/article adapters expect the ordinary LaTeX title
% registers.  Synchronize them from libre-compendium metadata before title
% processing, without changing the PDF implementation.
\ExplSyntaxOn
\AddToHook{begindocument/before}{
  \tl_if_empty:NF\g__lc_title_tl{\exp_args:NV\title\g__lc_title_tl}
  \tl_if_empty:NF\g__lc_author_tl{\exp_args:NV\author\g__lc_author_tl}
  \tl_if_empty:NF\g__lc_date_tl{\exp_args:NV\date\g__lc_date_tl}
}
\ExplSyntaxOff
