% TeX4ht adapter for lc-meta: emit structured HTML5 title header and
% copyright notice block, and restore Chinese headings for TOC/abstract.
\ExplSyntaxOn
\AddToHook{begindocument/before}{
  \tl_if_empty:NF\g__lc_title_tl{\exp_args:NV\title\g__lc_title_tl}
  \tl_if_empty:NF\g__lc_author_tl{\exp_args:NV\author\g__lc_author_tl}
  \tl_if_empty:NF\g__lc_date_tl{\exp_args:NV\date\g__lc_date_tl}
}
\AtBeginDocument{
  \cs_if_exist:NT\contentsname{\renewcommand{\contentsname}{目录}}
  \cs_if_exist:NT\abstractname{\renewcommand{\abstractname}{摘要}}
  \cs_if_exist:NT\figurename{\renewcommand{\figurename}{图}}
  \cs_if_exist:NT\tablename{\renewcommand{\tablename}{表}}
  \tl_if_empty:NF\g__lc_title_tl{\Configure{TITLE+}{\g__lc_title_tl}}
  \RenewDocumentCommand{\maketitle}{}{
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<header\space class="lc-titleblock">}
    \HCode{<h1\space class="lc-doc-title">}\g__lc_title_tl\HCode{</h1>}
    \tl_if_empty:NF\g__lc_subtitle_tl{
      \HCode{<p\space class="lc-doc-subtitle">}\g__lc_subtitle_tl\HCode{</p>}
    }
    \HCode{<p\space class="lc-doc-meta">}\__lc_author:\HCode{\space&middot;\space}\__lc_date:\HCode{</p>}
    \HCode{</header>}
    \HCode{<aside\space class="lc-notice">}
    \HCode{<p\space class="lc-notice-head"><strong>}\g__lc_title_tl\HCode{</strong>\space&middot;\space 版本\space}\g__lc_version_tl
    （\g__lc_commit_tl\tl_if_empty:NF\g__lc_commit_date_tl{，\g__lc_commit_date_tl}）\HCode{</p>}
    \HCode{<p\space class="lc-notice-copy">Copyright\space&copy;\space}\__lc_years:\HCode{\space}\g__lc_copyright_holder_tl\HCode{</p>}
    \HCode{<p>}本作品采用双重许可，您可以任选其一使用、复制、修改和分发：\HCode{</p>}
    \HCode{<ul\space class="lc-notice-list">}
    \HCode{<li>}GNU~自由文档许可证~1.3~或任何更高版本（GFDL-1.3-or-later）；\HCode{</li>}
    \HCode{<li>}知识共享~署名-相同方式共享~4.0~国际许可协议（CC~BY-SA~4.0）。\HCode{</li>}
    \HCode{</ul>}
    \HCode{<p\space class="lc-notice-en">}Permission~is~granted~to~copy,~distribute~and/or~modify~this~document~under~the~terms~of~the~GNU~Free~Documentation~License,~Version~1.3~or~any~later~version~published~by~the~Free~Software~Foundation;~with~no~Invariant~Sections,~no~Front-Cover~Texts,~and~no~Back-Cover~Texts.~A~copy~of~the~license~is~included~in~the~section~entitled~``GNU~Free~Documentation~License''.\HCode{</p>}
    \HCode{<p\space class="lc-notice-en">}This~work~is~also~licensed~under~the~Creative~Commons~Attribution-ShareAlike~4.0~International~License.~To~view~a~copy~of~this~license,~visit~\HCode{<a\space href="https://creativecommons.org/licenses/by-sa/4.0/">https://creativecommons.org/licenses/by-sa/4.0/</a>}.\HCode{</p>}
    \cs_if_exist:NT\lc@project@url{
      \tl_if_empty:NF\lc@project@url{
        \HCode{<p\space class="lc-notice-source">}源代码：\url{\lc@project@url}\HCode{</p>}
      }
    }
    \HCode{</aside>}\par\ShowPar
  }
}
\ExplSyntaxOff
