\NeedsTeXFormat{LaTeX2e}[2022-11-01]
\ProvidesPackage{lc-exercise}[2026/11/13 v0.1.0 习题与解答收集]
\ExplSyntaxOn
\tl_new:N\l__lc_solutions_tl
\tl_new:N\l__lc_show_tl
\tl_new:N\l__lc_points_tl
\tl_new:N\l__lc_levels_tl
\keys_define:nn{lc}{
 solutions .choices:nn={inline,chapter-end,end,hide}{\tl_set_eq:NN\l__lc_solutions_tl\l_keys_choice_tl},
 show .choices:nn={answer,solution,both}{\tl_set_eq:NN\l__lc_show_tl\l_keys_choice_tl},
 points .choices:nn={show,hide}{\tl_set_eq:NN\l__lc_points_tl\l_keys_choice_tl},
 levels .choices:nn={show,hide}{\tl_set_eq:NN\l__lc_levels_tl\l_keys_choice_tl}}
\lcset{solutions=hide,show=solution,points=hide,levels=show}
\tl_new:N\l__lc_ex_title_tl
\tl_new:N\l__lc_ex_level_tl
\tl_new:N\l__lc_ex_points_tl
\tl_new:N\l__lc_ex_source_tl
\tl_new:N\l__lc_ex_license_tl
\clist_new:N\l__lc_ex_tags_clist
\tl_new:N\g__lc_ex_answer_tl
\tl_new:N\g__lc_ex_solution_tl
\tl_new:N\l__lc_ex_selected_tl\tl_new:N\l__lc_ex_anchor_tl
\bool_new:N\l__lc_in_exercise_bool
\bool_new:N\g__lc_answer_seen_bool
\bool_new:N\g__lc_solution_seen_bool
\seq_new:N\g__lc_solutions_seq
\seq_new:N\g__lc_chapter_solutions_seq
\keys_define:nn{lc/exercise}{
 title .tl_set:N=\l__lc_ex_title_tl,
 level .choices:nn={basic,standard,advanced}{\tl_set_eq:NN\l__lc_ex_level_tl\l_keys_choice_tl},
 points .code:n={\regex_match:nnTF{\A[0-9]+(?:\.[0-9]+)?\Z}{#1}{\tl_set:Nn\l__lc_ex_points_tl{#1}}{\PackageError{lc-exercise}{points~必须为数字}{}}},
 source .tl_set:N=\l__lc_ex_source_tl,license .tl_set:N=\l__lc_ex_license_tl,tags .clist_set:N=\l__lc_ex_tags_clist}
\cs_if_exist:NTF\chapter{\newcounter{exercise}[chapter]\renewcommand{\theexercise}{\thechapter.\arabic{exercise}}}{\newcounter{exercise}[section]\renewcommand{\theexercise}{\thesection.\arabic{exercise}}}
\NewDocumentEnvironment{answer}{+b}{
 \bool_if:NTF\l__lc_in_exercise_bool{
 \bool_if:NT\g__lc_answer_seen_bool{\PackageError{lc-exercise}{每题只能有一个~answer}{}}
 \bool_gset_true:N\g__lc_answer_seen_bool\tl_gset:Nn\g__lc_ex_answer_tl{#1}}
 {\PackageError{lc-exercise}{answer~只能用于~exercise~内}{}}}{}
\cs_new_protected:Npn\__lc_ex_capture_solution:n#1{
 \bool_if:NT\g__lc_solution_seen_bool{\PackageError{lc-exercise}{每题只能有一个~solution}{}}
 \bool_gset_true:N\g__lc_solution_seen_bool\tl_gset:Nn\g__lc_ex_solution_tl{#1}}
\cs_new_protected:Npn\__lc_solution_item:nnn#1#2#3{
 \par\medskip\noindent\textbf{\hyperlink{#1}{\lc@name@exercise\c_space_tl #2}}\par #3}
\NewDocumentEnvironment{exercise}{O{}+b}{
 \tl_clear:N\l__lc_ex_title_tl\tl_clear:N\l__lc_ex_level_tl\tl_clear:N\l__lc_ex_points_tl
 \tl_clear:N\l__lc_ex_source_tl\tl_clear:N\l__lc_ex_license_tl\clist_clear:N\l__lc_ex_tags_clist
 \tl_gclear:N\g__lc_ex_answer_tl\tl_gclear:N\g__lc_ex_solution_tl\tl_clear:N\l__lc_ex_selected_tl
 \bool_gset_false:N\g__lc_answer_seen_bool\bool_gset_false:N\g__lc_solution_seen_bool
 \keys_set:nn{lc/exercise}{#1}\refstepcounter{exercise}\tl_set:Nx\l__lc_ex_anchor_tl{\@currentHref}
 \par\addvspace{0.65em}\noindent{\bfseries\str_if_eq:eeT{\lc@style}{boxed}{\color{lc-ink}}\lc@name@exercise\c_space_tl \theexercise
 \tl_if_empty:NF\l__lc_ex_title_tl{（\l__lc_ex_title_tl）}
 \tl_if_eq:NnT\l__lc_levels_tl{show}{\tl_if_empty:NF\l__lc_ex_level_tl{【\use:c{lc@name@\l__lc_ex_level_tl}】}}
 \tl_if_eq:NnT\l__lc_points_tl{show}{\tl_if_empty:NF\l__lc_ex_points_tl{（\l__lc_ex_points_tl\c_space_tl \lc@name@points）}}}
 \str_if_eq:eeTF{\lc@style}{boxed}{\par\nobreak}{\hspace{1em}}
 \tl_if_empty:NF\l__lc_ex_source_tl{\__lc_source_register:eeee{\@currentHref}{\lc@name@exercise\c_space_tl \theexercise}{\exp_not:V\l__lc_ex_source_tl}{\exp_not:V\l__lc_ex_license_tl}}
 \bool_set_true:N\l__lc_in_exercise_bool #2\par
 \str_case:Vn\l__lc_show_tl{
 {answer}{\tl_if_empty:NF\g__lc_ex_answer_tl{\tl_put_right:Nn\l__lc_ex_selected_tl{\__lc_response:nn{answer}}\tl_put_right:Nx\l__lc_ex_selected_tl{{\exp_not:V\g__lc_ex_answer_tl}}}}
 {solution}{\tl_if_empty:NF\g__lc_ex_solution_tl{\tl_put_right:Nn\l__lc_ex_selected_tl{\__lc_response:nn{solution}}\tl_put_right:Nx\l__lc_ex_selected_tl{{\exp_not:V\g__lc_ex_solution_tl}}}}
 {both}{\tl_if_empty:NF\g__lc_ex_answer_tl{\tl_put_right:Nn\l__lc_ex_selected_tl{\__lc_response:nn{answer}}\tl_put_right:Nx\l__lc_ex_selected_tl{{\exp_not:V\g__lc_ex_answer_tl}}}
 \tl_if_empty:NF\g__lc_ex_solution_tl{\tl_put_right:Nn\l__lc_ex_selected_tl{\__lc_response:nn{solution}}\tl_put_right:Nx\l__lc_ex_selected_tl{{\exp_not:V\g__lc_ex_solution_tl}}}}}
 \tl_if_empty:NF\l__lc_ex_selected_tl{\str_case:Vn\l__lc_solutions_tl{
 {inline}{\l__lc_ex_selected_tl}
 {end}{\seq_gput_right:Nx\g__lc_solutions_seq{\exp_not:N\__lc_solution_item:nnn{\l__lc_ex_anchor_tl}{\theexercise}{\exp_not:V\l__lc_ex_selected_tl}}}
 {chapter-end}{\seq_gput_right:Nx\g__lc_chapter_solutions_seq{\exp_not:N\__lc_solution_item:nnn{\l__lc_ex_anchor_tl}{\theexercise}{\exp_not:V\l__lc_ex_selected_tl}}}}}
 \par\addvspace{0.65em}}{}
\cs_new_protected:Npn\__lc_print_chapter_solutions:{\seq_if_empty:NF\g__lc_chapter_solutions_seq{
 \phantomsection\cs_if_exist:NTF\chapter{\section*{\lc@name@solutions}\addcontentsline{toc}{section}{\lc@name@solutions}}{\subsection*{\lc@name@solutions}\addcontentsline{toc}{subsection}{\lc@name@solutions}}
 \seq_map_inline:Nn\g__lc_chapter_solutions_seq{##1}\seq_gclear:N\g__lc_chapter_solutions_seq}}
\NewDocumentCommand{\lcprintsolutions}{}{
 \seq_if_empty:NF\g__lc_solutions_seq{\__lc_back_heading:n{\lc@name@solutions}\seq_map_inline:Nn\g__lc_solutions_seq{##1}\seq_gclear:N\g__lc_solutions_seq}
 \__lc_print_chapter_solutions:}
\cs_if_exist:NTF\chapter{\AddToHook{cmd/chapter/before}{\__lc_print_chapter_solutions:}}{\AddToHook{cmd/section/before}{\__lc_print_chapter_solutions:}}
\NewDocumentCommand{\lcinputexercises}{O{}m}{\group_begin:\lcset{#1}\input{#2}\group_end:}
\ExplSyntaxOff
