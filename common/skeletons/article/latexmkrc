# libre-compendium: 向上查找仓库中的 common/build-aux/latexmkrc 并载入
use Cwd qw(abs_path);
use File::Spec;
my $lc_dir = $ENV{LC_ROOT} ? abs_path($ENV{LC_ROOT}) : abs_path('.');
my $lc_common = $ENV{LC_ROOT} ? File::Spec->catfile(abs_path($ENV{LC_ROOT}), 'common', 'build-aux', 'latexmkrc') : undef;
while (! $ENV{LC_ROOT}) {
  my $cand = File::Spec->catfile($lc_dir, 'common', 'build-aux', 'latexmkrc');
  if (-f $cand) { $lc_common = $cand; last; }
  my $parent = abs_path(File::Spec->catdir($lc_dir, File::Spec->updir));
  die "latexmkrc: common/build-aux/latexmkrc not found\n" if $parent eq $lc_dir;
  $lc_dir = $parent;
}
$ENV{LC_ROOT} ||= $lc_dir;
$lc_common ||= File::Spec->catfile(abs_path($ENV{LC_ROOT}), 'common', 'build-aux', 'latexmkrc');
do $lc_common or die "latexmkrc: failed to load $lc_common: $@ $!\n";
